{
  // Drake (pirate). A genuine cutthroats' den — the concourse stops keep
  // their functional targets (Bar/CommodityExchange/... screens) but wear
  // pirate-flavored labels + tooltips so Drake reads as a black-market hole
  // instead of a generic station. Schema matches achilles/base.json.
  "display_name":  "Drake",
  "faction":       "Pirates",

  // Economy archetype (np-9cu.2) -- drives prices in
  // assets/data/commodity_prices.json.
  "market": { "archetype": "pirate" },

  "concourse_art": "bases/drake/concourse.png",

  "hotspots": [
    { "target": "Bar", "label": "THE DEN",
      "rect": [0.04, 0.50, 0.26, 0.16],
      "tooltip": "Cutthroats, fixers, and stiff drinks" },
    { "target": "CommodityExchange", "label": "BLACK MARKET",
      "rect": [0.37, 0.50, 0.26, 0.16],
      "tooltip": "Fence your loot - no questions asked" },
    { "target": "ShipDealer", "label": "CHOP SHOP",
      "rect": [0.70, 0.50, 0.26, 0.16],
      "tooltip": "Hot hulls, filed serial numbers, cheap" },
    { "target": "Equipment", "label": "GUNRUNNER",
      "rect": [0.04, 0.72, 0.26, 0.16],
      "tooltip": "Guns, shields, and nastier toys" },
    { "target": "MissionComputer", "label": "DIRTY WORK",
      "rect": [0.37, 0.72, 0.26, 0.16],
      "tooltip": "Jobs the law won't touch" },
    { "target": "Launch", "label": "LAUNCH",
      "rect": [0.70, 0.72, 0.26, 0.16],
      "tooltip": "Back out into the black" }
  ]
}
