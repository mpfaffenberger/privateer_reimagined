{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://new-privateer/assets/cinematics/schema.json",
  "title": "Cinematic timeline",
  "description": "Phase 1 flight-space cinematic. See docs/cinematic_format.md. The engine loads PNGs by path only; all portrait art is pre-generated by Python tooling.",
  "type": "object",
  "required": ["timeline"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "Logical id; defaults to the filename stem." },
    "letterbox": { "type": "boolean", "default": true },
    "skippable": { "type": "boolean", "default": true },
    "location": { "$ref": "#/definitions/location" },
    "outcome": { "$ref": "#/definitions/outcome" },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/definitions/cue" }
    }
  },
  "definitions": {
    "location": {
      "description": "Entry-point location: the system + nav the cinematic was authored against. Before playback the engine teleports the player there (queueing a system switch when needed) so the scene runs on its intended backdrop and outcome.player_at_nav can't silently no-op in the wrong system.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string", "description": "Galaxy system id, i.e. assets/systems/<system>.json." },
        "nav":    { "type": "string", "description": "Nav point name in that system (exact or bare-prefix match)." }
      }
    },
    "outcome": {
      "description": "Post-cinematic world state (Studio Phase A2, docs/cinematic_studio.md \u00a72). Applied on a natural end or a skip, never on an external stop.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "player_at_nav": { "type": "string", "description": "Teleport the player to this nav (current system)." },
        "player_pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3,
                        "description": "Exact world-coord drop point; takes precedence over player_at_nav (finales away from any nav)." },
        "spawns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["class"],
            "additionalProperties": false,
            "properties": {
              "class":   { "type": "string" },
              "faction": { "type": "string", "default": "civilian" },
              "count":   { "type": "integer", "minimum": 1, "default": 1 },
              "hostile": { "type": "boolean", "default": false },
              "cleared_flag": { "type": "string", "description": "Set this plot flag once all spawned ids in THIS group are dead/despawned." }
            }
          }
        }
      }
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "lookAt": {
      "description": "A world point [x,y,z] OR the string 'ship:<actor>' to track a spawned actor.",
      "oneOf": [
        { "$ref": "#/definitions/vec3" },
        { "type": "string", "pattern": "^ship:.+$" }
      ]
    },
    "cameraKey": {
      "type": "object",
      "required": ["pos"],
      "additionalProperties": false,
      "properties": {
        "pos": { "$ref": "#/definitions/vec3" },
        "look_at": { "$ref": "#/definitions/lookAt" }
      }
    },
    "actorKey": {
      "type": "object",
      "required": ["pos"],
      "additionalProperties": false,
      "properties": {
        "pos": { "$ref": "#/definitions/vec3" }
      }
    },
    "cue": {
      "type": "object",
      "required": ["t", "cmd"],
      "properties": {
        "t":   { "type": "number", "description": "Start time in seconds." },
        "cmd": {
          "type": "string",
          "enum": ["fade_in", "fade_out", "music", "sfx", "camera_path",
                   "spawn", "actor_path", "line", "subtitle", "end"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "cmd": { "enum": ["fade_in", "fade_out"] } } },
          "then": { "properties": { "dur": { "type": "number", "default": 1.0 } } }
        },
        {
          "if": { "properties": { "cmd": { "const": "music" } } },
          "then": {
            "required": ["file"],
            "properties": { "file": { "type": "string", "description": "path under assets/cinematics/audio/" } }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "sfx" } } },
          "then": {
            "required": ["file"],
            "properties": {
              "file": { "type": "string" },
              "pos":  { "$ref": "#/definitions/vec3", "description": "optional; present => positional 3D playback" }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "camera_path" } } },
          "then": {
            "required": ["keys", "dur"],
            "properties": {
              "dur":  { "type": "number" },
              "ease": { "type": "string", "enum": ["smooth", "linear"], "default": "smooth" },
              "follow": { "type": "string", "description": "Actor name to follow (e.g. 'hauler1'). Camera position = ship.pos + keys[0].pos each frame. Omit for spline mode." },
              "keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cameraKey" } }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "spawn" } } },
          "then": {
            "required": ["actor", "class", "pos"],
            "properties": {
              "actor":   { "type": "string" },
              "class":   { "type": "string", "description": "ship_class key" },
              "faction": { "type": "string", "default": "civilian" },
              "pos":     { "$ref": "#/definitions/vec3" }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "actor_path" } } },
          "then": {
            "required": ["actor", "keys", "dur"],
            "properties": {
              "actor": { "type": "string" },
              "dur":   { "type": "number" },
              "keys":  { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/actorKey" } }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "line" } } },
          "then": {
            "required": ["speaker", "text", "dur"],
            "properties": {
              "speaker":    { "type": "string" },
              "portrait":   { "type": "string", "description": "512x640 PNG under assets/cinematics/" },
              "text":       { "type": "string" },
              "voice_file": { "type": "string" },
              "side":       { "type": "string", "enum": ["left", "right"], "default": "left" },
              "dur":        { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "subtitle" } } },
          "then": {
            "required": ["text", "dur"],
            "properties": {
              "text": { "type": "string" },
              "dur":  { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "end" } } },
          "then": {
            "properties": {
              "actions": { "type": "array", "items": { "type": "string" }, "description": "plot::run_actions grammar tokens" }
            }
          }
        }
      ]
    }
  }
}
