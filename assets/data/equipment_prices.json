{
  // ---------------------------------------------------------------------------
  // equipment_prices.json — HAND-AUTHORED, TUNABLE outfitting prices for the
  // Equipment shop (np-9cu.3). Companion to ship_prices.json; same rationale
  // (no decoded canonical prices yet, so authored by hand + tunable here).
  //
  // outfitting.cpp reads this:
  //   * guns          — price to buy one gun of that type into a free mount.
  //                     Keyed by gun.cpp's lowercase_underscore short_name.
  //                     A gun absent here (or priced 0) is NOT for sale.
  //   * shield_level_price[L] — credits to UPGRADE the shield to level L
  //                     (index = target level; [0] is stock/free). Cumulative
  //                     ladder: each step costs shield_level_price[new_level].
  //   * engine_level_price[L] — same idea for the engine ladder.
  //   * engine_regen_bonus_per_level — ABSOLUTE GJ/s the engine upgrade adds
  //                     to the hull's energy-recharge rate (firing.cpp).
  //                     Index by engine level (so [0]=L0 stock, [1]=L1, ...).
  //                     Top speed + afterburner speed are HULL-only — engine
  //                     upgrades produce more power for weapons/shields/AB,
  //                     they don't make you go faster. (np-3dp.27 / gamefaq
  //                     4.6.2: "Higher levels of engine also produce more
  //                     power for other use, such as afterburner, weapons,
  //                     shields, and so on.")
  //   * shield_recharge_drain_per_level — ABSOLUTE GJ/s the shield gen
  //                     CONSUMES from the player's energy budget. Drains
  //                     whenever the gen is installed, regardless of state.
  //                     Index by shield level. If a shield gen outpaces the
  //                     player's available regen, the shield drains the bank
  //                     to zero and won't sustain.
  // ---------------------------------------------------------------------------

  // Canonical Privateer prices (gamefaq equipment list, np-3dp.26).
  "guns": {
    "laser":              1000,
    "mass_driver":        1500,
    "meson_blaster":      2500,
    "neutron_gun":        5000,
    "particle_cannon":    10000,
    "tachyon_cannon":     20000,
    "ionic_pulse_cannon": 40000,
    "plasma_gun":         80000
  },

  "armor": {
    "Plasteel Armor": 1000,
    "Tungsten Armor": 1500
  },

  // Shield generator ladder (target level -> price): L1 10k, L2 30k, L3 50k,
  // L4 100k, L5 150k. [0] is stock/free. Per-hull caps live in ship.json
  // (Tarsus L2, Centurion/Galaxy L3 in the original game).
  "shield_level_price": [0, 10000, 30000, 50000, 100000, 150000],

  // Engine ladder: L1 10k, L2 30k, L3 60k, L4 100k, L5 150k.
  "engine_level_price": [0, 10000, 30000, 60000, 100000, 150000],

  // Engine upgrade adds absolute GJ/s to the recharge rate. L0 = no bonus.
  // Hand-authored (no canonical numbers); tune freely.
  // L1=+55, L2=+70, L3=+90, L4=+112.5, L5=+135, L6=+157.5, L7=+180 GJ/s.
  "engine_regen_bonus_per_level": [0, 55, 70, 90, 112.5, 135, 157.5, 180],

  // Shield generator drain (absolute GJ/s consumed whenever the gen is
  // installed). L0 = no shield gen, no drain. Hand-authored.
  // L1 must stay below the starter Tarsus' 20 GJ/s hull recharge, or a
  // new-game ship has zero net weapon/afterburner energy regen. Yes,
  // balance bugs can be one rude number. L1=10, L2=45, L3=60, L4=80,
  // L5=100, L6=116.25, L7=132.5 GJ/s.
  "shield_recharge_drain_per_level": [0, 10, 45, 60, 80, 100, 116.25, 132.5],

  "cargo_expansion_price": 5000,

  // Scanner / radar product line (#143, scanner.cpp). Vendors, tiers,
  // prices and features are canonical (gamefaq 4.6.6): Iris is monochrome,
  // Hunter AW is friend-or-foe colour, B&S is fully colour-coded; tier 2
  // adds Target Lock (guided missiles only guide with it) and tier 3 adds
  // ITTS (the lead-prediction pip + aim gimbal). range_m is [I] invented
  // and tunable — Iris Mk I matches the 15 km hull default NPCs keep.
  // Selling (or buying over) a scanner refunds its full price, like guns.
  // A new game starts with player.h's k_starting_scanner (Iris Mk I).
  "scanners": [
    { "id": "iris_mk1",           "name": "Iris Mk I",          "price":  10000, "range_m": 15000, "color_iff": false, "target_lock": false, "itts": false },
    { "id": "iris_mk2",           "name": "Iris Mk II",         "price":  30000, "range_m": 17500, "color_iff": false, "target_lock": true,  "itts": false },
    { "id": "iris_mk3",           "name": "Iris Mk III",        "price":  60000, "range_m": 20000, "color_iff": false, "target_lock": true,  "itts": true  },
    { "id": "hunter_aw_6",        "name": "Hunter AW 6",        "price":  30000, "range_m": 17500, "color_iff": true,  "target_lock": false, "itts": false },
    { "id": "hunter_aw_6i",       "name": "Hunter AW 6i",       "price":  50000, "range_m": 20000, "color_iff": true,  "target_lock": true,  "itts": false },
    { "id": "hunter_aw_infinity", "name": "Hunter AW Infinity", "price":  80000, "range_m": 22500, "color_iff": true,  "target_lock": true,  "itts": true  },
    { "id": "bs_tripwire",        "name": "B&S Tripwire",       "price":  40000, "range_m": 20000, "color_iff": true,  "target_lock": false, "itts": false },
    { "id": "bs_eye",             "name": "B&S E.Y.E.",         "price":  70000, "range_m": 25000, "color_iff": true,  "target_lock": true,  "itts": false },
    { "id": "bs_omni",            "name": "B&S Omni",           "price": 100000, "range_m": 30000, "color_iff": true,  "target_lock": true,  "itts": true  }
  ],

  // Turret hardware (#145): price per turret POSITION a hull supports
  // (ship.json turret_slot: Centurion/Orion rear, Galaxy top/bottom).
  // Buys the empty turret; each gun fitted into it is bought separately at
  // the "guns" price above. Hand-authored (the gamefaq lists no price).
  "turret_price": 10000,

  // Discrete buy-once-per-ship upgrades (np-3dp.27). Each is a bool flag on
  // PlayerState + Ship (own / don't own). None of the game's hulls ship
  // with any of these — a fresh Tarsus from the dealer has NONE, so it
  // can't jump, has no tractor, no repair droid, etc. until you buy them.
  "discrete_equipment": {
    "jump_drive":         10000,
    "ecm_l1":              5000,
    "ecm_l2":             15000,
    "ecm_l3":             30000,
    "repair_droid":       10000,
    "adv_repair_droid":   90000,
    "tractor_beam":        7500
  }
}
