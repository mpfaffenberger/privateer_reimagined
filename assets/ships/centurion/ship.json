{
  // Authored from docs/privateer_ship_data.json (np-9cu.3): the Centurion
  // is the premium bounty-hunter combat hull. Sprites existed already; this
  // is the stat/loadout side the ship dealer + flight code read. Four fixed
  // forward guns (Mass Drivers x2 + Tachyon + Particle) plus a rear
  // auto-turret (2x Ionic Pulse) that bites pursuers.
  "name":           "centurion",
  "display_name":   "Centurion",
  "class_label":    "Bounty Hunter Heavy Fighter",
  "atlas_manifest": "ships/centurion/atlas_manifest_3d.json",
  "default_faction": "hunter",

  "armor_fore_cm": 20,
  "armor_aft_cm":  15,
  "armor_side_cm": 15,

  "cruise_speed":      500,
  "afterburner_speed": 1000,
  "acceleration":      "excellent",
  "max_ypr":           "good",

  "personality":       "standard",

  "weapons_range": 5000,

  "max_engine_level": 3,
  "ypr_rate_multiplier": 1.4,
  "max_shield_level": 3,
  "default_shield":   "Shield Generator 2",

  // Mount offsets are in WORLD units (firing.cpp body_to_world applies no
  // scale) and ships render ~140u, so guns sit on the wings: mass drivers
  // out near the wingtips, tachyon/particle inboard, turrets at the tail.
  // turret_slot groups turret mounts into one purchasable position (#145):
  // the player buys the "rear" turret hardware, then a gun per mount.
  "default_guns": [
    { "offset_body": [-27.2, 4.8, 24.0], "type": "mass_driver" },
    { "offset_body": [ 27.2, 4.8, 24.0], "type": "mass_driver" },
    { "offset_body": [ -8.8, 4.8, 27.2], "type": "tachyon_cannon" },
    { "offset_body": [  8.8, 4.8, 27.2], "type": "particle_cannon" },

    { "offset_body": [-5.6, 0.0, -24.0], "forward_body": [0, 0, -1], "cone_half_angle_deg": 120, "type": "ionic_pulse_cannon", "turret": true, "turret_slot": "rear" },
    { "offset_body": [ 5.6, 0.0, -24.0], "forward_body": [0, 0, -1], "cone_half_angle_deg": 120, "type": "ionic_pulse_cannon", "turret": true, "turret_slot": "rear" }
  ],

  "energy_max":      250,
  "energy_recharge": 35,

  "cargo_units":     50,
  "cargo_units_max": 75
}
