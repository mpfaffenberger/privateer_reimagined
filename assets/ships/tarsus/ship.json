{
  "name":           "tarsus",
  "display_name":   "Tarsus",
  "class_label":    "Merchant Scout",
  "atlas_manifest": "ships/tarsus/atlas_manifest_3d.json",
  "default_faction": "merchant",

  "armor_fore_cm": 10,
  "armor_aft_cm":  10,
  "armor_side_cm":  8,

  // Back to canonical Privateer numbers (300 / 600) — Mike's call to
  // keep NPC Tarsuses on the same hull-feel page as the player's Tarsus
  // (which caps at 300/600 in camera.h). The brief 380/800 experiment
  // was to give fleeing merchants a sporting chance against the
  // 400-cruise Talon; at canon they're slower than the pursuer, which
  // is the intended dynamic anyway (merchants need help, hence Militia).
  "cruise_speed":      300,
  "afterburner_speed": 600,
  "acceleration":      "average",
  "max_ypr":           "average",

  // Merchant role: flee on sight. Personality drives the AI state
  // transition — "hostile in radar" maps to Flee, regardless of HP.
  "personality":       "coward",

  // Doubled from canonical 2500 m to match the longer-range demo regime.
  "weapons_range": 5000,

  "max_engine_level": 2,
  "max_shield_level": 2,
  "default_shield":   "Shield Generator 1",

  // Gun hardpoints (body frame, metres) — the single source of truth for
  // muzzle geometry, used by BOTH the player cockpit and NPC Tarsuses.
  // Convention: +X = right, +Y = DOWN on the cockpit crosshair (positive Y
  // drops the muzzle below the eye line), and the camera looks down -Z, so
  // a NEGATIVE Z puts the muzzle in FRONT of the eye. Z MUST be non-zero:
  // at Z=0 the muzzle sits in the eye plane (view depth 0) and projects
  // degenerately, which makes left/right drift apart on screen. Guns fill
  // in list order (new Tarsus -> slot 0, bought 2nd gun -> slot 1). Tune
  // here — no code change.
  "default_guns": [
    { "offset_body": [-5.00, 4.50, -20.00], "type": "mass_driver" },
    { "offset_body": [ 4.00, 5.00, -20.00], "type": "mass_driver" }
  ],

  // Stock missile rack (#524), from privateer_ship_data.json "Weapons".
  "default_missiles": { "DF": 3 },

  // Starter-hull energy (#743). Net new-game regen = 40 - 10 (shield L1
  // drain) = 30 GJ/s, which covers the stock twin lasers' 26.7 GJ/s burn, so
  // the stock guns never run dry. At 20 a new pilot netted 10 GJ/s and lost
  // every fight on energy alone. test_outfitting guards this invariant.
  "energy_max":      150,
  "energy_recharge": 40,

  "cargo_units":     100,
  "cargo_units_max": 150
}
