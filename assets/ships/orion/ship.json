{
  // Authored from docs/privateer_ship_data.json (np-9cu.3): the Orion is the
  // heavily-armoured mercenary gunship — slow and tanky, the highest engine
  // ceiling of the player hulls (Max Engine Level 5). Sprites existed
  // already; this is the stat/loadout side the dealer + flight code read.
  "name":           "orion",
  "display_name":   "Orion",
  "class_label":    "Mercenary Gunship",
  "atlas_manifest": "ships/orion/atlas_manifest_3d.json",
  "default_faction": "civilian",

  "armor_fore_cm": 48,
  "armor_aft_cm":  50,
  "armor_side_cm": 35,

  "cruise_speed":      350,
  "afterburner_speed": 800,
  "acceleration":      "average",
  "max_ypr":           "poor",

  "personality":       "standard",
  "ai_table":          "heavy",

  "radar_range":   25000,
  "weapons_range": 5000,

  "max_engine_level": 5,
  "max_shield_level": 3,
  "default_shield":   "Shield Generator 3",

  // Plasma Guns x2: heavy-hitter loadout fitting the gunship role. Each
  // gun = 7.2 cm dmg, 0.8s refire, 22 GJ/shot, range 3196 m, speed 840 m/s
  // (gamefaq s4.5.2). At energy 220 / recharge 30 GJ/s the Orion sustains
  // ~13.6 GJ/s deficit per gun while firing both, so it bursts ~5 seconds
  // then has to ease off -- exactly the hit-and-pull-back rhythm the heavy
  // AI profile already imposes (no afterburner break-off; hold standoff).
  "default_guns": [
    { "offset_body": [-3.0, 0.0, 3.0], "type": "plasma_gun" },
    { "offset_body": [ 3.0, 0.0, 3.0], "type": "plasma_gun" },

    { "offset_body": [-0.6, 0.0, -3.0], "forward_body": [0, 0, -1], "cone_half_angle_deg": 120, "type": "laser", "turret": true },
    { "offset_body": [ 0.6, 0.0, -3.0], "forward_body": [0, 0, -1], "cone_half_angle_deg": 120, "type": "laser", "turret": true }
  ],

  "energy_max":      220,
  "energy_recharge": 30,

  "cargo_units":     50,
  "cargo_units_max": 75
}
