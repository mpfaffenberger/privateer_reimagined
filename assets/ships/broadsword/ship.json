{
  // Authored from assets/data/privateer_ship_data.json (np Troy Confed wing):
  // the Broadsword is the Confederation HEAVY fighter / bomber — slow and
  // un-afterburnered but heavily armored and bristling with guns (3 forward
  // Mass Drivers plus particle/laser turrets we don't model) and a deep
  // missile rack. Flies the "heavy" AI profile: standoff, hammer, don't
  // chase. Sprites are the wcnews BRDSWRDX mesh capture.
  "name":           "broadsword",
  "display_name":   "Broadsword",
  "class_label":    "Confederation Heavy Fighter",
  "atlas_manifest": "ships/broadsword/atlas_manifest_3d.json",
  "default_faction": "confed",

  "armor_fore_cm": 25,
  "armor_aft_cm":  20,
  "armor_side_cm": 18,

  "cruise_speed":      350,
  "afterburner_speed": 350,
  "acceleration":      "average",
  "max_ypr":           "average",

  "personality":       "standard",
  "ai_table":          "heavy",

  "weapons_range": 4500,

  "max_engine_level": 3,
  "max_shield_level": 4,
  "default_shield":   "Shield Generator 4",

  // Mass Drivers x3 — the canonical forward battery (turreted particle/laser
  // omitted per the v1 no-turret scope note).
  "default_guns": [
    { "offset_body": [-3.5, 0.0, 3.0], "type": "mass_driver" },
    { "offset_body": [ 0.0, -0.5, 3.5], "type": "mass_driver" },
    { "offset_body": [ 3.5, 0.0, 3.0], "type": "mass_driver" }
  ],

  // Stock missile rack (#524), from privateer_ship_data.json "Weapons".
  "default_missiles": { "FF": 6, "HS": 3 },

  "energy_max":      240,
  "energy_recharge": 32,

  "cargo_units":     20,
  "cargo_units_max": 40
}
