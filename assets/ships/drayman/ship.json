{
  "name":           "drayman",
  "display_name":   "Drayman",
  "class_label":    "Merchant Ship",
  "atlas_manifest": "ships/drayman/atlas_manifest_3d.json",
  "default_faction": "merchant",

  // Capital hull: huge + slow. Keeps ≥2000u from other capitals at spawn
  // and ≥1000u in transit (see encounters.cpp / ship_ai.cpp).
  "capital": true,

  "armor_fore_cm":  35,
  "armor_aft_cm":   30,
  "armor_side_cm":  28,

  "cruise_speed":      150,
  "afterburner_speed": 0,
  "acceleration":      "poor",
  "max_ypr":           "poor",

  "personality":       "coward",

  "weapons_range": 4000,

  "max_engine_level": 2,
  "max_shield_level": 5,
  "default_shield":   "Shield Generator 5",

  // Two fixed forward Meson Blasters plus one Mass Driver on each defensive
  // turret mount: dorsal, ventral, and rear. The turrets keep firing even
  // while the coward AI runs for the jump point.
  "default_guns": [
    { "offset_body": [-4.0, 0.0, 6.0], "type": "meson_blaster" },
    { "offset_body": [ 4.0, 0.0, 6.0], "type": "meson_blaster" },

    { "offset_body": [0.0,  4.0,  0.0], "forward_body": [0,  1,  0], "cone_half_angle_deg": 120, "type": "mass_driver", "turret": true },
    { "offset_body": [0.0, -4.0,  0.0], "forward_body": [0, -1,  0], "cone_half_angle_deg": 120, "type": "mass_driver", "turret": true },
    { "offset_body": [0.0,  0.0, -7.0], "forward_body": [0,  0, -1], "cone_half_angle_deg": 120, "type": "mass_driver", "turret": true }
  ],

  "energy_max":      220,
  "energy_recharge": 28,

  "cargo_units":     300,
  "cargo_units_max": 450
}
