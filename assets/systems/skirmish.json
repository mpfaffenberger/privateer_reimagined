{
  // ---------------------------------------------------------------------
  // skirmish.json -- 4-ship multi-faction AI playtest:
  //   * 1 militia Talon (defends the merchant, engages pirates)
  //   * 2 pirate Talons (hostile to player, militia, AND merchant)
  //   * 1 merchant Tarsus (coward -> flees pirates + player on sight)
  // Player gets to watch (or join) the resulting brawl. No encounter
  // spawner. Launch with:  ./build/new_privateer --system skirmish
  // ---------------------------------------------------------------------
  "name":        "Skirmish",
  "description": "4-ship multi-faction skirmish playtest.",

  "skybox_seed": "sector_4774",
  "star":        { "preset": "blue" },

  "placed_sprites": [
    {
      "sprite":        "sprites/mining_base",
      "position":      [200000, -133333, 0],
      "length_meters": 3000
    }
  ],

  // All four ships dead ahead of player_start, fanned slightly so they're
  // distinguishable in the cockpit. Player faces +X / slightly -Z.
  "placed_ship_sprites": [
    // Merchant Tarsus -- the protectee. ~3.5 km ahead, slightly left. Class
    // default faction = merchant (coward personality -> flees pirates +
    // the player on sight). Sits in the convoy slot.
    {
      "atlas":         "ships/tarsus/atlas_manifest",
      "position":      [53500, -100000, 31900],
      "length_meters": 100,
      "ai": { "initial_state": "idle" }
    },

    // Militia Talon -- the defender. ~4 km ahead, screening the Tarsus.
    // Faction override (class default = pirate); militia is allied with
    // merchant and hostile to pirate.
    {
      "atlas":         "ships/talon/atlas_manifest",
      "position":      [54000, -100000, 31750],
      "length_meters": 80,
      "faction":       "militia",
      "ai": { "initial_state": "idle" }
    },

    // Pirate Talon #1 -- attacker. ~5.5 km out, slightly low/right.
    // Class default faction (pirate) -- hostile to player, merchant,
    // militia.
    {
      "atlas":         "ships/talon/atlas_manifest",
      "position":      [55500, -100200, 31300],
      "length_meters": 80,
      "ai": { "initial_state": "idle" }
    },

    // Pirate Talon #2 -- attacker. ~5.5 km out, slightly high/left.
    {
      "atlas":         "ships/talon/atlas_manifest",
      "position":      [55500,  -99800, 32100],
      "length_meters": 80,
      "ai": { "initial_state": "idle" }
    }
  ],

  "nav_points": [
    { "name": "Achilles Mining", "kind": "station", "position": [200000, -133333, 0],
      "dockable": true, "base_id": "achilles" },
    { "name": "Convoy",          "kind": "ship",    "position": [53750, -100000, 31825] }
  ],

  // No dynamic spawns -- clean 4-ship fight.
  "encounters": [],

  "player_start": {
    "position": [50000, -100000, 33333],
    "look_at":  [54700, -100000, 31650]
  }
}
