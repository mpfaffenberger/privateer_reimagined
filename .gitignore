# OS cruft
.DS_Store
._*
/~/

# Generated skyboxes (regenerated on demand by tools/gen_skybox.sh).
# All used seeds (troy + every skybox_seed referenced from assets/systems/*.json)
# need to ship with the repo so a fresh clone on any platform can render every
# system, not just Troy. Previously only 'troy' was tracked, which broke
# Windows clones the moment the player jumped to Pyrenees / Pender's Star /
# any other system that asks for its own cubemap. If you generate a new
# experimental seed that you DON'T want committed, ignore it explicitly here.

# runtime logs
*.log

# Imported ship meshes from ../privateer_wcu. Derived from Origin/EA game
# assets — local use only, regenerate with tools/import_wcu_meshes.sh.
assets/meshes/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Local API credentials (never commit secrets)
.openai_api_key

# Python bytecode caches
__pycache__/
*.pyc

# In-game sprite atlas capture dirs (regeneratable via tools/tour_ship_sprite_atlas.sh)
assets/ships/*/sprites_ingame/

# Regeneration trial dirs (local sprite/mesh experiment scratch).
assets/ships/*/regen_trials/

# NOTE: /generated/ is intentionally NOT ignored. The cross-machine generation
# workspace (incl. generated/gog_extracted/ GOG-derived data) is deliberately
# LFS-tracked via .gitattributes (generated/**) per #226 and lives only in this
# private repo. Do not re-add /generated/ here.

# In-game sprite-generation workbench requests/logs/status files
assets/shipgen/

# Original Origin/EA WC sprite cache (do not redistribute)
assets/ships/*/wcnews_sprites/

# Atlas cells derived from wcnews wcpedia (still derived from Origin IP)
assets/ships/*/sprites_wcnews/

# Canonical 1993 character art pulled from wcnews wcpedia by
# tools/download_wcnews_character_refs.py. Used ONLY as local conditioning
# references for portrait generation -- do not redistribute Origin IP.
assets/cinematics/portraits/_wcnews_refs/

# Original Privateer SFX converted from the user's SOUNDFX.PAK via
# tools/extract_soundfx_pak.py. Procedural placeholders in assets/sfx/ act as
# the fallback; sfx::load_all prefers originals when present. *.voc covers
# any stray extracted Creative VOCs, BUT the speech pack under assets/speech/
# is intentionally tracked (fuck EA).
assets/sfx/original/
*.voc
!assets/speech/**/*.VOC
!assets/speech/**/*.voc

# Privateer's original music rendered from GOG .ADL/.GEN XMIDI via
# tools/render_music.py. The renderers (tools/ail2wopl.py, tools/xmidi2smf.py,
# tools/render_music.py) + docs ARE tracked.
assets/music/original/

# User-supplied synth data for the HQ render (np-gln): GM SoundFonts and
# Roland MT-32 ROMs are copyrighted third-party assets — never commit them.
*.sf2
*.dls
*.sf3
MT32_*.ROM
CM32L_*.ROM

# ────────────────────────────────────────────────────────────────────
# Root-level GOG extraction scratch (raw IFF/VOC/sprites for local tooling).
# Re-create with: tools/extract_privateer.sh — never commit. The ANALYZED GOG
# data that must persist cross-machine lives under generated/gog_extracted/ and
# IS LFS-tracked per #226. Derived facts (stats/labels/prices) live in
# docs/privateer_db/ and ARE tracked.
# ────────────────────────────────────────────────────────────────────
/gog_extracted/

# ────────────────────────────────────────────────────────────────────
# Vendored DMJC/wctools — source patched-in-tree IS tracked,
# build artifacts are not.
# Build with: cd third_party/wctools/wctre && make
# ────────────────────────────────────────────────────────────────────
/third_party/wctools/wctre/wctre
/third_party/wctools/unpak/unpak

# RE scratch area is gitignored wholesale (binaries, dumps, the patched CD,
# the PRIV.TRE master + the DOSBox conf/launcher are all derived from the
# user's OWN game data -- never commit). The ONE exception is the Plan B
# patch tool: it's pure code (no game data), so it IS committable. The
# step-down !-rules below re-include just that file (git can't un-ignore a
# file whose parent dir is ignored, hence the explicit dir un-ignores).
/re/*
!/re/dosbox/
/re/dosbox/*
!/re/dosbox/patch_cnst.py

# --- Voice-line pipeline ---
# Unique/runtime audio is tracked in Git LFS so fresh Windows clones work.
# These analysis caches and organizational mirrors are regenerable; the mirror
# folders duplicate tracked audio and often use symlinks that are hostile to
# default Windows Git checkouts.
assets/speech/flight_embeddings.npz
assets/speech/flight_by_voice/
assets/speech/bar_by_speaker/
build_debug/

# Cinematic portrait pipeline content-hash cache (regenerable)
tools/cinematics/.cache/

# Voice-synthesis content-hash cache (regenerable; the SHIPPED clips live in
# assets/cinematics/audio/ -- this is just the dedup blob store behind them)
tools/cinematics/.cache_voice/

# Cinematic Studio bridge liveness heartbeat. Rewritten every polling loop;
# runtime state belongs in the worktree, not in version history.
assets/cinematics/studio/bridge.alive
