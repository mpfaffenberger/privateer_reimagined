# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# ============================================================
# Project-specific (new_privateer / space_sim)
# ============================================================

# Build outputs
build/
build-*/
cmake-build-*/

# Generated shader headers (sokol-shdc output)
src/generated/
*.glsl.h

# Editor / IDE
.vscode/
.idea/
*.code-workspace
*.swp
compile_commands.json

# OS cruft
.DS_Store
._*

# Generated skyboxes (regenerated on demand by tools/gen_skybox.sh).
# Keep 'troy' so the binary has a default cubemap out of the box.
assets/skybox/*
!assets/skybox/troy/

# runtime logs
*.log

# Imported ship meshes from ../privateer_wcu. Derived from Origin/EA game
# assets — local use only, regenerate with tools/import_wcu_meshes.sh.
assets/meshes/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Python bytecode caches
__pycache__/
*.pyc

# In-game sprite atlas capture dirs (regeneratable via tools/tour_ship_sprite_atlas.sh)
assets/ships/*/sprites_ingame/

# Local AI sprite regeneration experiments (promote intentionally if useful)
assets/ships/*/regen_trials/

# In-game sprite-generation workbench requests/logs/status files
assets/shipgen/

# Original Origin/EA WC sprite cache (do not redistribute)
assets/ships/*/wcnews_sprites/

# Atlas cells derived from wcnews wcpedia (still derived from Origin IP)
assets/ships/*/sprites_wcnews/

# Original Privateer SFX converted from the user's OWN SOUNDFX.PAK via
# tools/extract_soundfx_pak.py. Local-use only (OpenMW legal model) —
# never commit the extracted/converted audio. The procedural placeholders
# in assets/sfx/ stay the committed fallback; sfx::load_all prefers these
# originals when present. *.voc covers any stray extracted Creative VOCs.
assets/sfx/original/
*.voc

# Privateer's original music (np-m96 AdLib OPL / np-gln General MIDI+MT-32):
# rendered from the GOG .ADL/.GEN XMIDI via tools/render_music.py. Same legal
# model as the SFX — the rendered/original WAVs are LOCAL-ONLY, never commit
# them. The renderers (tools/ail2wopl.py, tools/xmidi2smf.py,
# tools/render_music.py) + docs ARE tracked.
assets/music/original/

# User-supplied synth data for the HQ render (np-gln): GM SoundFonts and
# Roland MT-32 ROMs are copyrighted third-party assets — never commit them.
*.sf2
*.dls
*.sf3
MT32_*.ROM
CM32L_*.ROM

# ────────────────────────────────────────────────────────────────────
# Privateer GOG-derived data — copyrighted Origin/EA, never commit.
# Re-create with: tools/extract_privateer.sh
# Derived facts (stats/labels/prices) live in docs/privateer_db/ and ARE tracked.
# ────────────────────────────────────────────────────────────────────
/gog_extracted/

# ────────────────────────────────────────────────────────────────────
# Vendored DMJC/wctools — source patched-in-tree IS tracked,
# build artifacts are not.
# Build with: cd third_party/wctools/wctre && make
# ────────────────────────────────────────────────────────────────────
/third_party/wctools/wctre/wctre
/third_party/wctools/unpak/unpak

# RE scratch area is gitignored wholesale (binaries, dumps, the patched CD,
# the PRIV.TRE master + the DOSBox conf/launcher are all derived from the
# user's OWN game data -- never commit). The ONE exception is the Plan B
# patch tool: it's pure code (no game data), so it IS committable. The
# step-down !-rules below re-include just that file (git can't un-ignore a
# file whose parent dir is ignored, hence the explicit dir un-ignores).
/re/*
!/re/dosbox/
/re/dosbox/*
!/re/dosbox/patch_cnst.py
